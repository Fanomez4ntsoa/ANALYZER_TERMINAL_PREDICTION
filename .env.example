APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API-Football
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Bookmaker unique des cotes des prédictions (id API-Football, 8 = Bet365)
API_FOOTBALL_PREFERRED_BOOKMAKER=8
API_FOOTBALL_REQUESTS_PER_MINUTE=10
# Périmètre du relevé des cotes (ids API-Football) : Top 5. Matchs et scores restent importés sur toutes les ligues.
API_FOOTBALL_ODDS_LEAGUES=39,78,135,140,61
API_FOOTBALL_OPTIONAL_RESERVE=10

# The Odds API
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Bookmaker de référence du CLV (clé The Odds API). Distinct du précédent :
# le CLV mesure le mouvement de Pinnacle, pas celui du prix Bet365.
ODDS_API_CLV_BOOKMAKER=pinnacle

# OpenWeatherMap
OPENWEATHERMAP_KEY=
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# Timezone d'affichage (DB reste en UTC)
DISPLAY_TIMEZONE=Indian/Antananarivo

# Filtre horaire pipeline (heures UTC)
PIPELINE_MATCH_START_HOUR=12
PIPELINE_MATCH_END_HOUR=21

# Passage quotidien pipeline:daily (planificateur)
PIPELINE_SCHEDULE_TIME=10:00
PIPELINE_SCHEDULE_TIMEZONE=UTC

# Clôture automatique (CLV) : fenêtre avant coup d'envoi, championnats, réserve de quota
PIPELINE_CLOSING_WINDOW_MINUTES=10
PIPELINE_CLOSING_QUOTA_RESERVE=50

# Collecte (CollectionGuard) : true sur la seule machine de référence, le VPS.
# Sur le portable : absent ou false. pipeline:daily, pipeline:run(-sync),
# pipeline:backfill, context:enrich et market:track snapshot|closing|close y
# refusent de tourner. Voir docs/deploiement.md.
PIPELINE_ENABLED=false
PIPELINE_REFERENCE_HOST="le VPS, deploy:/home/deploy/football-analyzer-web"

# Run de référence du panneau de calibration, écrit par backtest:reference
BACKTEST_REFERENCE_RUN=1

# Trois clés d'API seulement (API-Football, The Odds API, OpenWeatherMap) :
# ANTHROPIC_API_KEY n'est plus lue depuis la suppression des agents (14/09/2026).
