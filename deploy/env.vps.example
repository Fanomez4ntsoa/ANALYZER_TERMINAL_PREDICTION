# .env du VPS, machine de référence (docs/deploiement.md, étape 3).
# Copier en .env à la racine du projet, remplir les valeurs <...>, puis lancer
# ./setup.sh. Droits 600 : setup.sh les pose.
#
# Trois clés d'API, pas quatre : ANTHROPIC_API_KEY n'est plus lue depuis la
# suppression des agents IA (14/09/2026). Ne pas l'ajouter.

APP_NAME=football-analyzer
APP_ENV=production
# Rempli par setup.sh (key:generate) s'il est vide
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Journal applicatif : un fichier par jour, 14 jours. Le journal du pipeline
# (storage/logs/pipeline-*.log) garde ses 60 jours (config/logging.php).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base dédiée, créée avec sudo mysql (docs/deploiement.md, étape 2)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=football_analyzer
DB_USERNAME=football_analyzer
DB_PASSWORD=<mot de passe de l'utilisateur MariaDB dédié>
# Session MariaDB en UTC : les heures (TIMESTAMP) écrites par Laravel restent en UTC
DB_TIMEZONE=+00:00

SESSION_DRIVER=database
CACHE_STORE=database
# Aucun worker de file sur le VPS : tout job s'exécute dans le processus qui le lance
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ── Collecte ────────────────────────────────────────────────────────────────
# Seule machine qui collecte. Sur le portable : absent ou false (CollectionGuard).
PIPELINE_ENABLED=true
PIPELINE_REFERENCE_HOST="le VPS, deploy:/home/deploy/football-analyzer-web"

# API-Football (100 requêtes/jour, offre gratuite)
API_FOOTBALL_KEY=<clé API-Football>
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_PREFERRED_BOOKMAKER=8
API_FOOTBALL_REQUESTS_PER_MINUTE=10
API_FOOTBALL_ODDS_LEAGUES=39,78,135,140,61
API_FOOTBALL_OPTIONAL_RESERVE=10

# The Odds API (500 crédits/mois) : clôture Pinnacle
ODDS_API_KEY=<clé The Odds API>
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_CLV_BOOKMAKER=pinnacle

# OpenWeatherMap : météo du contexte
OPENWEATHERMAP_KEY=<clé OpenWeatherMap>
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

DISPLAY_TIMEZONE=Indian/Antananarivo

PIPELINE_MATCH_START_HOUR=12
PIPELINE_MATCH_END_HOUR=21
PIPELINE_SCHEDULE_TIME=10:00
PIPELINE_SCHEDULE_TIMEZONE=UTC
PIPELINE_CLOSING_WINDOW_MINUTES=10
PIPELINE_CLOSING_QUOTA_RESERVE=50

# Écrit par backtest:reference, ne pas modifier à la main
BACKTEST_REFERENCE_RUN=1
